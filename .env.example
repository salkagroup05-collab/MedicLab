# SunuMed est un SaaS multi-cabinets qui utilise Supabase (Postgres + Auth)
# comme backend. Créez un projet sur https://supabase.com, exécutez le script
# supabase/migrations/0001_init.sql dans l'éditeur SQL, puis renseignez ici l'URL
# du projet et sa clé publique "anon" (Project Settings > API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
